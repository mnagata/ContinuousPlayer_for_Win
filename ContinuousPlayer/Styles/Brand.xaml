<Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
<Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource MainTextBrush}"/><Setter Property="CornerRadius" Value="24"/><Setter Property="BorderThickness" Value="0"/>
</Style>
<Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
<Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="4"/>
</Style>
<Style x:Key="BrowserButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
<Setter Property="CornerRadius" Value="24"/><Setter Property="BorderThickness" Value="1"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Style>
<Style x:Key="BrowserIconButtonStyle" TargetType="Button" BasedOn="{StaticResource BrowserButtonStyle}">
<Setter Property="Padding" Value="0"/>
</Style>
<Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
<Setter Property="Background" Value="{ThemeResource PrimaryBrush}"/>
<Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
<Setter Property="BorderBrush" Value="{ThemeResource PrimaryStrokeBrush}"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="CornerRadius" Value="16"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Style></ResourceDictionary>
