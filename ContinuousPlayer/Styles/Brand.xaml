<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.ThemeDictionaries>
<ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="CanvasBrush" Color="#000000"/>
<SolidColorBrush x:Key="MainTextBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="MutedTextBrush" Color="#A9B6D5"/>
<SolidColorBrush x:Key="AccentTextBrush" Color="#66DFFF"/>
<SolidColorBrush x:Key="BrowserBrush" Color="#111B32"/>
<SolidColorBrush x:Key="BrowserStrokeBrush" Color="#42556D"/>
<SolidColorBrush x:Key="ScrimBrush" Color="#B0000000"/>
<SolidColorBrush x:Key="ToolbarBrush" Color="#B0000000"/>
<LinearGradientBrush x:Key="HomeBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#123652" Offset="0"/><GradientStop Color="#101743" Offset=".5"/><GradientStop Color="#35204F" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18BFD9" Offset="0"/><GradientStop Color="#7560E8" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="LogoBackBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9474FF" Offset="0"/><GradientStop Color="#FF8EDB" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="LogoFrontBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#36E5F5" Offset="0"/><GradientStop Color="#348AFF" Offset="1"/></LinearGradientBrush></ResourceDictionary>
<ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="CanvasBrush" Color="#000000"/>
<SolidColorBrush x:Key="MainTextBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="MutedTextBrush" Color="#A9B6D5"/>
<SolidColorBrush x:Key="AccentTextBrush" Color="#66DFFF"/>
<SolidColorBrush x:Key="BrowserBrush" Color="#111B32"/>
<SolidColorBrush x:Key="BrowserStrokeBrush" Color="#42556D"/>
<SolidColorBrush x:Key="ScrimBrush" Color="#B0000000"/>
<SolidColorBrush x:Key="ToolbarBrush" Color="#B0000000"/>
<LinearGradientBrush x:Key="HomeBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#123652" Offset="0"/><GradientStop Color="#101743" Offset=".5"/><GradientStop Color="#35204F" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18BFD9" Offset="0"/><GradientStop Color="#7560E8" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="LogoBackBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9474FF" Offset="0"/><GradientStop Color="#FF8EDB" Offset="1"/></LinearGradientBrush>
<LinearGradientBrush x:Key="LogoFrontBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#36E5F5" Offset="0"/><GradientStop Color="#348AFF" Offset="1"/></LinearGradientBrush></ResourceDictionary>
<ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/><SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
<SolidColorBrush x:Key="HomeBrush" Color="{ThemeResource SystemColorWindowColor}"/>
<SolidColorBrush x:Key="BrowserBrush" Color="{ThemeResource SystemColorWindowColor}"/>
<SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}"/>
<SolidColorBrush x:Key="ToolbarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
<SolidColorBrush x:Key="MainTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
<SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
<SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
<SolidColorBrush x:Key="BrowserStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
<SolidColorBrush x:Key="PrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
<SolidColorBrush x:Key="LogoBackBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
<SolidColorBrush x:Key="LogoFrontBrush" Color="{ThemeResource SystemColorWindowTextColor}"/></ResourceDictionary>
</ResourceDictionary.ThemeDictionaries>
<Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
<Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource MainTextBrush}"/><Setter Property="CornerRadius" Value="8"/>
</Style>
</ResourceDictionary>
