<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ContinuousPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ContinuousPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ContinuousPlayer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RequestedTheme="Dark" Loaded="WindowLayout_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="ContinuousPlayer" Height="48" Background="{ThemeResource BrowserBrush}" Foreground="{ThemeResource MainTextBrush}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ContentControl x:Name="PlaybackTitleBarActions" VerticalContentAlignment="Center"/>
                    <Button Click="Fullscreen_Click" Width="40" Height="40" AutomationProperties.AutomationId="WindowFullscreen" AutomationProperties.Name="全画面にする" ToolTipService.ToolTip="全画面にする (F11)"><FontIcon Glyph="&#xE740;" FontSize="16" Width="16" Height="16"/></Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
